{
  "name": "@civ-clone/base-city-improvement-rules",
  "version": "0.1.0",
  "description": "City improvement mechanics for a ruleset to wrap with its own ids, numbers and improvements: build rules from requirement entries, built once a city, the capital, registering and announcing a new improvement, destruction with the city, upkeep, obsolescence and a computer player's build priorities.",
  "repository": "git@github.com:civ-clone/base-city-improvement-rules.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "lib/*.js.map",
    "lib/*.ts"
  ],
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.0.0",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.1.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@civ-clone/base-diplomacy-declaration-peace": "^0.1.0",
    "@civ-clone/core-city": "^0.1.24",
    "@civ-clone/core-city-build": "^0.1.22",
    "@civ-clone/core-city-growth": "^0.1.6",
    "@civ-clone/core-city-improvement": "^0.1.8",
    "@civ-clone/core-diplomacy": "^0.1.8",
    "@civ-clone/core-engine": "^0.1.6",
    "@civ-clone/core-player": "^0.1.10",
    "@civ-clone/core-registry": "^0.1.6",
    "@civ-clone/core-requirement": "^0.1.3",
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-science": "^0.1.9",
    "@civ-clone/core-unit": "^0.1.31",
    "@civ-clone/core-world": "^0.1.24",
    "@civ-clone/core-yield": "^0.1.6"
  }
}
